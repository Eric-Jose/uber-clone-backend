# Firebase Admin Config
FIREBASE_PROJECT_ID=seu-projeto-id
FIREBASE_PRIVATE_KEY=sua-chave-privada-com-\\n
FIREBASE_CLIENT_EMAIL=seu-email-do-service-account
FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com

# Firebase Web API key (used only by the server to verify email/password through Firebase Auth REST API)
FIREBASE_WEB_API_KEY=sua-web-api-key

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=gere-uma-chave-longa-e-aleatoria
